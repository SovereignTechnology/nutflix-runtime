{
  "name": "@nutflix-runtime/renderer",
  "version": "0.0.0",
  "private": true,
  "description": "The Chromium renderer: @sovit/ui over Nostr relays (browser WebSocket) and the worker's framed pipe; free NFX videos over HyperDHT",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "bundle": "node scripts/build.ts",
    "test": "vitest run",
    "test:e2e": "node scripts/build.ts && vitest run --config vitest.e2e.config.ts",
    "test:netns": "node scripts/build.ts && vitest run --config vitest.netns.config.ts",
    "test:publish": "node scripts/build.ts && vitest run --config vitest.publish.config.ts",
    "lint": "eslint src scripts e2e"
  },
  "dependencies": {
    "@nutflix-runtime/worker": "0.0.0",
    "@sovit/core": "0.0.0",
    "@sovit/ui": "0.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@sovit/seeder": "0.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "bare-sidecar": "0.5.4",
    "esbuild": "0.28.2",
    "hyperdht": "6.36.0",
    "jsdom": "29.1.1",
    "nostr-tools": "2.26.0",
    "playwright-core": "1.65.0",
    "ws": "8.22.2"
  }
}
