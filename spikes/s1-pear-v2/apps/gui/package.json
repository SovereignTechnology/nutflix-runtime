    },
    "links": {
      "loopback": "http://127.0.0.1"
    }
  },
  "dependencies": {
    "b4a": "1.8.0",
    "bare-env": "3.0.0",
    "bare-fs": "4.7.1",
    "bare-http1": "4.5.6",
    "pear-bridge": "1.2.5",
    "pear-electron": "1.7.28",
    "pear-pipe": "1.0.6"
  }
}
