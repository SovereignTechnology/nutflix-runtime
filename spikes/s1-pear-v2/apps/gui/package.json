{
  "name": "s1-gui",
  "version": "0.0.1",
  "description": "S1: minimal pear-electron GUI app with a Bare side, for a pre-v3 Pear runtime",
  "main": "index.js",
  "license": "Apache-2.0",
  "pear": {
