# Spike S2: everything the harness downloads, pinned. Sourced by run.sh.
# Holepunch's Electron template, at the commit this spike used (2026-11-17, "update
# electron-forge dependencies (#99)"). Its package-lock.json pins pear-runtime 1.3.1,
# pear-runtime-updater 3.4.0, electron 42.11.18, @electron-forge/cli 8.0.1,
# pear-electron-forge-maker-appimage 3.0.1.
TEMPLATE_REPO=https://github.com/holepunchto/hello-pear-electron.git
TEMPLATE_COMMIT=ed067ea5d8a9b22a98a879789ef8b56bfc4acbd2

# The npm bootstrapper (it pulls the platform from PEAR_PLATFORM_LINK over HyperDHT).
# latest on npm since 2026-07-14; the integrity is the registry's dist.integrity.
PEAR_NPM_VERSION=3.0.0
PEAR_NPM_INTEGRITY=sha512-nTUqvyGrDSCNJuvaBgBbygXgKJcUVJpr9hww3/AysocUgpW5gdbV4HveXI+KxJc/Y0Rti752xP8h9LkZL4AnNw==
PEAR_PLATFORM_LINK=pear://smw4thqaqed9iq6bae7a9cxd4fesruixgkafe38jny33ahs33igy
