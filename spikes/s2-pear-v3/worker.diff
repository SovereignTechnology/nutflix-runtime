+function sha256Stream(stream) {
+  const streaming = typeof sodium.crypto_hash_sha256_init === 'function'
+  return new Promise((resolve, reject) => {
+    const state = streaming ? b4a.alloc(sodium.crypto_hash_sha256_STATEBYTES) : null
+    const chunks = []
+    if (streaming) sodium.crypto_hash_sha256_init(state)
+    stream.on('data', (chunk) => {
+      if (streaming) sodium.crypto_hash_sha256_update(state, chunk)
+      else chunks.push(chunk)
+    })
+    stream.on('error', reject)
+    stream.on('end', () => {
+      const out = b4a.alloc(sodium.crypto_hash_sha256_BYTES)
+      if (streaming) sodium.crypto_hash_sha256_final(state, out)
+      else sodium.crypto_hash_sha256(out, b4a.concat(chunks))
+      resolve(b4a.toString(out, 'hex'))
