+// S2 question 3: read the newest build on the drive, before the updater mirrors it.
+async function readAhead(trigger) {
+  const d = pear.updater.drive
+  await d.ready()
+  await d.update()
+  const length = d.core.length
+  const fork = d.core.fork
+  if (!length) return log('read-ahead', { trigger, empty: true })
+  const co = d.checkout(length)
+  try {
+    const pkgBuf = await co.get('/package.json')
+    const pkg = pkgBuf ? JSON.parse(b4a.toString(pkgBuf)) : null
+    const files = []
+    for await (const entry of co.list('/', { recursive: true })) {
+      files.push({
+        path: entry.key,
+        bytes: entry.value.blob ? entry.value.blob.byteLength : null,
+        executable: entry.value.executable
+      })
+    }
+    const p = '/by-arch/' + host + '/app/' + updaterConfig.name
+    const entry = await co.entry(p)
+    const t0 = Date.now()
+    const sha256 = entry ? await sha256Stream(co.createReadStream(p)) : null
+    log('read-ahead', {
+      trigger,
+      verlink: verlinkOf(fork, length, d.key),
+      version: pkg && pkg.version,
+      upgrade: pkg && pkg.upgrade,
+      files,
+      artifact: p,
+      entry: safe(entry),
+      sha256,
+      hashMs: Date.now() - t0
+    })
+  } finally {
+    await co.close()
+  }
+}
