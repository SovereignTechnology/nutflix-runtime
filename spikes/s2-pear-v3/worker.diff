+function safe(v, depth = 0) {
+  if (v === null || v === undefined) return v === undefined ? '<undefined>' : null
+  const t = typeof v
+  if (t === 'string' || t === 'number' || t === 'boolean') return v
+  if (t === 'bigint') return v.toString()
+  if (t === 'function') return '<function ' + (v.name || 'anonymous') + '>'
+  if (v instanceof Error) {
+    return {
+      error: v.message,
+      code: v.code,
+      stack: String(v.stack || '')
+        .split('\n')
+        .slice(0, 4)
+        .join(' | ')
+    }
+  }
+  if (ArrayBuffer.isView(v)) {
+    const buf = b4a.from(v.buffer, v.byteOffset, v.byteLength)
+    return { buffer: buf.byteLength, hex: b4a.toString(buf.subarray(0, 32), 'hex') }
+  }
+  if (depth > 4) return '<depth>'
+  if (Array.isArray(v)) return v.slice(0, 50).map((x) => safe(x, depth + 1))
+  const out = {}
+  const ctor = v.constructor && v.constructor.name
+  if (ctor && ctor !== 'Object') out.__class = ctor
+  for (const k of Object.keys(v).slice(0, 40)) out[k] = safe(v[k], depth + 1)
+  return out
