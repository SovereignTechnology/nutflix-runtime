+function driveState() {
+  const d = pear.updater.drive
+  return {
+    key: hid.encode(d.key),
+    fork: d.core.fork,
+    length: d.core.length,
+    verlink: d.core.length ? verlinkOf(d.core.fork, d.core.length, d.key) : null,
