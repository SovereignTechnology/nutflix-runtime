+  const next = u.next
+  const id = path.basename(next) // the updater names it `${length}.${fork}`
+  const [length, fork] = id.split('.').map(Number)
+  const file = path.join(next, 'by-arch', host, 'app', updaterConfig.name)
+  const t0 = Date.now()
+  const sha256 = await sha256File(file)
+  const c = {
+    next,
+    id,
+    verlink: verlinkOf(fork, length, u.drive.key),
+    version: u.nextVersion,
+    file,
+    size: fs.statSync(file).size,
+    sha256
+  }
+  candidate = c
+  log('gate-candidate', {
+    ...c,
+    hashMs: Date.now() - t0,
+    updater: {
+      length: u.length,
+      nextVersion: u.nextVersion,
+      updated: u.updated,
+      updating: u.updating,
+      applied: !!u.applied,
+      bundled: u.bundled,
+      app: u.app
+    },
+    drive: driveState(),
+    nextListing: listLocal(next)
+  })
